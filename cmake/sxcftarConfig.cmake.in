@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LibArchive)
find_dependency(OpenSSL COMPONENTS Crypto)
find_dependency(Threads)
find_dependency(nlohmann_json 3.2.0)
find_dependency(PkgConfig)
pkg_check_modules(LIBCONFIGPP REQUIRED IMPORTED_TARGET libconfig++)
include("${CMAKE_CURRENT_LIST_DIR}/sxcftarTargets.cmake")
if(NOT TARGET Smithproxy::CfTar)
    add_library(Smithproxy::CfTar INTERFACE IMPORTED)
    set_target_properties(Smithproxy::CfTar PROPERTIES INTERFACE_LINK_LIBRARIES sxcftar::sxcftar)
endif()
check_required_components(sxcftar)
